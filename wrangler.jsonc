// Cloudflare Workers（静的アセットのみ）の設定（plan 10.2）。
// Cloudflare の「Workers Builds」が `npx wrangler deploy` で読み込む。
// name は Cloudflare 上の Worker 名と一致させる（違うと別の Worker ができる）。
{
  "name": "educomweb2",
  "compatibility_date": "2026-11-01",
  // デプロイの前にビルドする（Pagefind の索引作りまで含む npm run build を使う）
  "build": {
    "command": "npm run build",
  },
  "assets": {
    "directory": "./dist/",
    // 存在しない URL には dist/404.html を 404 で返す
    "not_found_handling": "404-page",
    // /news → /news/ のように末尾のスラッシュをそろえる
    "html_handling": "auto-trailing-slash",
  },
}
