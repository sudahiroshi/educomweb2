---
/**
 * お知らせの一覧行（spec 5.6、案B）：掲載日＋タイトル。<ul> の中で使う。
 */
import type { NewsData } from '../schemas';
import { formatDate } from '../lib/format-date';

interface Props {
  news: { id: string; data: Pick<NewsData, 'title' | 'published'> };
  href?: string;
}

const { news, href = `/news/${news.id}/` } = Astro.props;
---

<li class="news-item">
  <p class="meta">
    <time datetime={news.data.published}>{formatDate(news.data.published)}</time>
  </p>
  <a class="title" href={href}>
    {news.data.title}
  </a>
</li>

<style>
  .news-item {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-block: 0.9rem;
    border-bottom: var(--border-width) solid var(--color-border);
  }

  .news-item:last-child {
    border-bottom: 0;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }

  .title {
    align-self: flex-start;
    color: var(--color-text);
    font-weight: 500;
  }
</style>
