---
/**
 * Markdown 本文の体裁（spec 5.6）。本文を <Prose><Content /></Prose> のように囲む。
 * 表は rehype-site が .table-scroll で囲む（特大・幅 320px でもはみ出さない）。
 */
---

<div class="prose">
  <slot />
</div>

<style>
  .prose {
    max-width: 46rem;
  }

  .prose :global(> * + *) {
    margin-top: 1.1em;
  }

  .prose :global(h2) {
    margin-top: 2.2em;
    padding-bottom: 0.3em;
    border-bottom: var(--border-width) solid var(--color-border);
    font-size: var(--font-size-h2);
  }

  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: var(--font-size-h3);
  }

  .prose :global(h4) {
    margin-top: 1.5em;
    font-size: var(--font-size-body);
  }

  .prose :global(:is(h2, h3, h4) + *) {
    margin-top: 0.6em;
  }

  .prose :global(a) {
    color: var(--color-accent);
  }

  .prose :global(:is(ul, ol)) {
    padding-inline-start: 1.6em;
  }

  .prose :global(li + li) {
    margin-top: 0.3em;
  }

  .prose :global(blockquote) {
    margin-inline: 0;
    padding-inline-start: 1em;
    border-inline-start: 4px solid var(--color-accent-soft);
    color: var(--color-muted);
  }

  .prose :global(hr) {
    border: 0;
    border-top: var(--border-width) solid var(--color-border);
  }

  .prose :global(img) {
    display: block;
    border-radius: var(--radius-small);
  }

  .prose :global(code) {
    padding: 0.1em 0.35em;
    border-radius: 6px;
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    font-size: 0.9em;
  }

  .prose :global(pre) {
    overflow-x: auto;
    padding: 1em;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
  }

  .prose :global(pre code) {
    padding: 0;
    background: none;
    color: inherit;
  }

  .prose :global(.table-scroll) {
    /* 中の visually-hidden（position: absolute）が枠の外に出てページを広げないよう、位置の基準にする */
    position: relative;
    max-width: 100%;
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-small);
  }

  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    /* 本文の overflow-wrap: anywhere が列幅を押しつぶさないようにする。狭い画面では枠内で横スクロール */
    overflow-wrap: normal;
  }

  .prose :global(td) {
    min-width: 6em;
  }

  .prose :global(:is(th, td)) {
    padding: 0.6em 0.9em;
    border-bottom: var(--border-width) solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  .prose :global(th) {
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    font-weight: 700;
    white-space: nowrap;
  }

  .prose :global(tr:last-child td) {
    border-bottom: 0;
  }
</style>
