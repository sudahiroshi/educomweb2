---
/**
 * 外部リンク（spec 8章）。アイコンと読み上げ用の「（外部サイト）」を付ける。
 * Markdown 本文の外部リンク（rehype-site）と同じ見た目・同じ文言にする。
 */
import type { HTMLAttributes } from 'astro/types';
import { EXTERNAL_ICON_PATHS, EXTERNAL_LABEL } from '../lib/markdown/external';

type Props = HTMLAttributes<'a'> & { href: string };
const { href, class: className, ...rest } = Astro.props;
---

<a href={href} class:list={['external-link', className]} {...rest}>
  <slot />
  <svg
    class="external-icon"
    viewBox="0 0 24 24"
    width="1em"
    height="1em"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {EXTERNAL_ICON_PATHS.map((d) => (
      <path d={d} />
    ))}
  </svg>
  <span class="visually-hidden" data-pagefind-ignore>
    {EXTERNAL_LABEL}
  </span>
</a>
