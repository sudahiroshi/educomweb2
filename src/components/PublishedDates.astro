---
/** 掲載日・更新日（spec 3.6）。更新日は掲載日と違うときだけ表示する */
import { formatDate } from '../lib/format-date';

interface Props {
  published?: string;
  updated?: string;
}
const { published, updated } = Astro.props;
const showUpdated = updated !== undefined && updated !== published;
---

{(published || showUpdated) && (
  <p class="dates">
    {published && (
      <span>
        掲載日：<time datetime={published}>{formatDate(published)}</time>
      </span>
    )}
    {showUpdated && updated && (
      <span>
        更新日：<time datetime={updated}>{formatDate(updated)}</time>
      </span>
    )}
  </p>
)}

<style>
  .dates {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }
</style>
