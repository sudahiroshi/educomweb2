---
/**
 * 開催予定カード（spec 5.6、案B）：日付ブロック＋種類＋タイトル＋会場。
 * 閲覧時の判定（spec 3.3）のため、data-end（終了基準日）と data-fy（年度）を付ける。
 * カード全体が押せる（タイトルのリンクをカード全体に広げる）。
 */
import type { EventData } from '../schemas';
import { dateBlock, formatEventDate } from '../lib/format-date';
import { eventEndDate } from '../lib/event-status';
import { eventFiscalYear } from '../lib/fiscal-year';
import { eventUrl } from '../lib/event-kind';
import { textLang } from '../lib/lang';
import KindBadge from './KindBadge.astro';

interface Props {
  event: {
    id: string;
    data: Pick<EventData, 'kind' | 'title' | 'startDate' | 'endDate' | 'venue'>;
  };
  /** タイトルの見出しレベル（ページの見出し構造に合わせる） */
  headingLevel?: 2 | 3 | 4;
  /** リンク先（編集画面のプレビューなどで差し替える） */
  href?: string;
}

const { event, headingLevel = 3, href = eventUrl(event) } = Astro.props;
const { data } = event;
const block = dateBlock(data.startDate, data.endDate);
const Heading = `h${headingLevel}` as 'h2' | 'h3' | 'h4';
---

<article
  class="event-card"
  data-end={eventEndDate(event)}
  data-fy={eventFiscalYear(event)}
  data-event-item
>
  <div class="date-block" aria-hidden="true">
    <span class="date-year">{block.year}</span>
    <span class="date-month">{block.month}</span>
    <span class="date-day">{block.day}</span>
  </div>
  <div class="body">
    <KindBadge kind={data.kind} variant="text" />
    <Heading class="title">
      <a href={href} lang={textLang(data.title)}>
        {data.title}
      </a>
    </Heading>
    <p class="meta">
      <time datetime={data.startDate}>{formatEventDate(data.startDate, data.endDate)}</time>
    </p>
    {data.venue && <p class="meta">会場：{data.venue}</p>}
    <slot />
  </div>
</article>

<style>
  .event-card {
    position: relative;
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.25rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .event-card:hover {
    border-color: var(--color-accent);
  }

  .event-card:focus-within {
    outline: var(--focus-width) solid var(--color-focus);
    outline-offset: 2px;
  }

  .date-block {
    display: flex;
    flex: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 5.2rem;
    padding: 0.6rem 0.5rem;
    border-radius: var(--radius-small);
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    line-height: 1.3;
    text-align: center;
  }

  .date-year,
  .date-day {
    font-size: 0.75rem;
  }

  .date-month {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    min-width: 0;
  }

  .title {
    font-size: var(--font-size-h3);
  }

  .title a {
    color: var(--color-text);
  }

  /* タイトルのリンクをカード全体に広げる */
  .title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius-card);
  }

  .title a:focus-visible {
    outline: none;
  }

  .meta {
    color: var(--color-muted);
    font-size: var(--font-size-small);
  }

  @media (max-width: 420px) {
    .event-card {
      flex-direction: column;
    }

    .date-block {
      flex-direction: row;
      gap: 0.5rem;
      align-items: baseline;
      padding: 0.35rem 0.8rem;
    }
  }
</style>
