---
/**
 * 記事詳細（活動記録・研究発表会・国際会議）（spec 4.1）：
 * 種類ラベル、開催日、会場、外部リンク、セッション表、本文、掲載日・更新日（この順）。
 */
import { render } from 'astro:content';
import type { EventEntry } from '../lib/queries';
import { kindListTitle, kindListUrl } from '../lib/event-kind';
import { summarize } from '../lib/summary';
import PageLayout from '../layouts/PageLayout.astro';
import { KindBadge } from './ui/KindBadge';
import { EventInfo, EventLinks, EventProgram } from './ui/EventSections';
import Prose from './Prose.astro';
import { PublishedDates } from './ui/PublishedDates';

interface Props {
  entry: EventEntry;
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const hasBody = (entry.body ?? '').trim() !== '';
---

<PageLayout
  searchable
  ogType="article"
  title={data.title}
  breadcrumbs={[
    { label: kindListTitle(data.kind), href: kindListUrl(data.kind) },
    { label: data.title },
  ]}
  description={summarize(data.summary, entry.body)}
>
  <KindBadge slot="before-title" kind={data.kind} variant="text" />

  <EventInfo data={data} />
  <EventLinks data={data} />
  <EventProgram data={data} />

  {/* spec 4.1 の順：セッション表 → 本文 */}
  {hasBody && (
    <Prose>
      <Content />
    </Prose>
  )}

  <PublishedDates published={data.published} updated={data.updated} />
</PageLayout>
