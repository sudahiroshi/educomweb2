---
/**
 * セッション情報＋講演一覧の表（spec 5.6・3.7・8章、D-15〜D-17）。
 * 表には <caption>（セッション名）と <th scope> を付け、横スクロール枠に入れる。
 * 講演番号・所属は、どの講演にも入力がなければ列ごと出さない。
 */
import type { Session } from '../schemas';
import { formatSessionDateTime } from '../lib/format-date';
import { textLang } from '../lib/lang';
import { formatPresenter } from '../lib/talk';

interface Props {
  sessions: readonly Session[];
  /** セッション名の見出しレベル */
  headingLevel?: 3 | 4;
}

const { sessions, headingLevel = 3 } = Astro.props;
const Heading = `h${headingLevel}` as 'h3' | 'h4';
---

{sessions.map((session, i) => {
  const talks = session.talks ?? [];
  const hasNumber = talks.some((t) => t.number);
  const hasAffiliation = talks.some((t) => t.affiliation);
  const dateTime = formatSessionDateTime(session.date, session.startTime, session.endTime);
  const headingId = `session-${i + 1}`;
  return (
    <section class="session" aria-labelledby={headingId}>
      <Heading id={headingId} class="session-name" lang={textLang(session.name)}>
        {session.name}
      </Heading>
      {(dateTime || session.room || session.chair || session.viceChair) && (
        <dl class="session-info">
          {dateTime && (
            <div>
              <dt>日時</dt>
              <dd>{session.date ? <time datetime={session.date}>{dateTime}</time> : dateTime}</dd>
            </div>
          )}
          {session.room && (
            <div>
              <dt>会場</dt>
              <dd>{session.room}</dd>
            </div>
          )}
          {session.chair && (
            <div>
              <dt>座長</dt>
              <dd>{session.chair}</dd>
            </div>
          )}
          {session.viceChair && (
            <div>
              <dt>副座長</dt>
              <dd>{session.viceChair}</dd>
            </div>
          )}
        </dl>
      )}
      {talks.length > 0 && (
        <div
          class="table-scroll"
          role="region"
          aria-labelledby={`${headingId}-caption`}
          tabindex="0"
        >
          <table>
            <caption id={`${headingId}-caption`}>{session.name} の講演一覧</caption>
            <thead>
              <tr>
                {hasNumber && <th scope="col">講演番号</th>}
                <th scope="col">演題</th>
                <th scope="col">発表者</th>
                {hasAffiliation && <th scope="col">所属</th>}
              </tr>
            </thead>
            <tbody>
              {talks.map((talk) => (
                <tr>
                  {hasNumber && <td class="number">{talk.number}</td>}
                  <td class="talk-title" lang={textLang(talk.title)}>
                    {talk.title}
                  </td>
                  <td class="presenter">{formatPresenter(talk)}</td>
                  {hasAffiliation && <td>{talk.affiliation}</td>}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </section>
  );
})}

<style>
  .session {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .session-name {
    font-size: var(--font-size-h3);
  }

  .session-info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    font-size: var(--font-size-small);
  }

  .session-info div {
    display: flex;
    gap: 0.5rem;
  }

  .session-info dt {
    color: var(--color-muted);
    font-weight: 700;
    white-space: nowrap;
  }

  .session-info dd {
    margin: 0;
  }

  .table-scroll {
    max-width: 100%;
    overflow-x: auto;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-small);
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.95rem;
    /* 本文の overflow-wrap: anywhere が列幅を押しつぶさないようにする。狭い画面では枠内で横スクロール */
    overflow-wrap: normal;
  }

  .talk-title {
    min-width: 14em;
  }

  caption {
    padding: 0.5rem 0.9rem;
    color: var(--color-muted);
    font-size: var(--font-size-small);
    text-align: start;
  }

  th,
  td {
    padding: 0.6em 0.9em;
    border-top: var(--border-width) solid var(--color-border);
    text-align: start;
    vertical-align: top;
  }

  th {
    background: var(--color-accent-soft);
    color: var(--color-accent-soft-text);
    font-weight: 700;
    white-space: nowrap;
  }

  .number,
  .presenter {
    white-space: nowrap;
  }
</style>
