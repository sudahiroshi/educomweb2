---
/**
 * テーマ切替ボタン（spec 5.4、D-48）。
 * - アイコンのみ：ライト時は月、ダーク時は太陽。aria-label は切り替え先を示す
 * - 押すと保存（asj-edcom:theme）。保存値がない間は OS の設定の変化に追従する
 * - スクリプトが動かない環境では表示しない
 */
---

<button
  type="button"
  class="theme-toggle"
  data-theme-toggle
  hidden
  aria-label="ダークモードに切り替え"
>
  <svg class="icon icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>
  </svg>
  <svg class="icon icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  import {
    THEME_KEY,
    isTheme,
    readStored,
    writeStored,
    type Theme,
  } from '../scripts/display-settings';

  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');

  function currentTheme(): Theme {
    return root.dataset.theme === 'dark' ? 'dark' : 'light';
  }

  function updateButtons() {
    const dark = currentTheme() === 'dark';
    document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
      button.setAttribute('aria-label', dark ? 'ライトモードに切り替え' : 'ダークモードに切り替え');
    });
  }

  function applyTheme(theme: Theme) {
    root.dataset.theme = theme;
    updateButtons();
  }

  document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]').forEach((button) => {
    button.hidden = false;
    button.addEventListener('click', () => {
      const next: Theme = currentTheme() === 'dark' ? 'light' : 'dark';
      writeStored(THEME_KEY, next);
      applyTheme(next);
    });
  });
  updateButtons();

  // 保存値がなければ、OS の設定が後から変わったときに追従する
  media.addEventListener('change', (event) => {
    if (isTheme(readStored(THEME_KEY))) return;
    applyTheme(event.matches ? 'dark' : 'light');
  });
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-size);
    height: var(--tap-size);
    padding: 0;
    border: var(--border-width) solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--color-accent);
  }

  .icon {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .icon-sun {
    display: none;
  }

  :global([data-theme='dark']) .icon-sun {
    display: block;
  }

  :global([data-theme='dark']) .icon-moon {
    display: none;
  }
</style>
