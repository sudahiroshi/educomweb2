---
/**
 * 全ページ共通のレイアウト（spec 4.4・7章）。
 * - <title>：「{ページ名} | 日本音響学会 音響教育委員会」。トップはサイト名のみ
 * - スキップリンク「本文へ移動」→ <main id="main">
 */
import '../styles/global.css';
import { site } from '../config/site';
import { INIT_SCRIPT } from '../scripts/display-settings';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  /** ページ名。省略時（トップ）はサイト名のみ */
  title?: string;
  /** meta description */
  description?: string;
  /** 検索エンジンに載せない（編集画面など） */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* テーマと文字サイズを描画前に適用する（spec 5.1。ちらつき防止のため CSS より前） */}
    <script is:inline set:html={INIT_SCRIPT} />
    <title>{fullTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={site.name} href="/rss.xml" />
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">
      本文へ移動
    </a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>

<style>
  main {
    display: block;
    padding-block: 2.5rem 4rem;
  }

  main:focus {
    outline: none;
  }
</style>
