---
/** お知らせ詳細（spec 4.1）：タイトル、掲載日・更新日、本文、関連記事 */
import type { GetStaticPaths } from 'astro';
import { getEntries, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Prose from '../../components/Prose.astro';
import { RelatedEvents } from '../../components/ui/RelatedEvents';
import { PublishedDates } from '../../components/ui/PublishedDates';
import { loadNews } from '../../lib/queries';
import { compareEnded } from '../../lib/sort';
import { summarize } from '../../lib/summary';

export const getStaticPaths = (async () => {
  const { news } = await loadNews();
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);
// 関連記事（D-20）。存在しない ID はビルド時の検査で失敗させている（src/content.config.ts）
const related = entry.data.related ? (await getEntries(entry.data.related)).sort(compareEnded) : [];
---

<PageLayout
  searchable
  ogType="article"
  title={entry.data.title}
  breadcrumbs={[{ label: 'お知らせ', href: '/news/' }, { label: entry.data.title }]}
  description={summarize(entry.data.summary, entry.body)}
>
  <PublishedDates
    slot="after-title"
    published={entry.data.published}
    updated={entry.data.updated}
  />
  <Prose>
    <Content />
  </Prose>
  <RelatedEvents events={related} />
</PageLayout>
