---
/** メディア出演（年度別）（spec 4.2） */
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../../layouts/PageLayout.astro';
import EventArchive from '../../../components/EventArchive.astro';
import { kindFiscalYearUrl } from '../../../lib/event-kind';
import { formatFiscalYear } from '../../../lib/fiscal-year';
import { loadEvents } from '../../../lib/queries';

export const getStaticPaths = (async () => {
  const events = await loadEvents('media');
  return events.endedFiscalYears.map((fy) => ({
    params: { year: String(fy) },
    props: { events, fiscalYear: fy },
  }));
}) satisfies GetStaticPaths;

const { events, fiscalYear } = Astro.props;
const label = formatFiscalYear(fiscalYear);
---

<PageLayout
  title={`メディア出演 ${label}`}
  breadcrumbs={[{ label: 'メディア出演', href: '/media/' }, { label }]}
>
  <EventArchive
    events={events}
    fiscalYear={fiscalYear}
    hrefFor={(fy) => kindFiscalYearUrl('media', fy)}
    navLabel="メディア出演の年度別一覧"
  />
</PageLayout>
