---
/** メディア出演（kind: media）の一覧（ユーザー判断で追加。構成は活動記録と同じ。spec 4.2） */
import PageLayout from '../../layouts/PageLayout.astro';
import EventArchive from '../../components/EventArchive.astro';
import { kindFiscalYearUrl } from '../../lib/event-kind';
import { loadEvents } from '../../lib/queries';

const events = await loadEvents('media');
---

<PageLayout
  title="メディア出演"
  description="日本音響学会 音響教育委員会の新聞・テレビなどへの出演・掲載の記録です。"
>
  <EventArchive
    events={events}
    hrefFor={(fy) => kindFiscalYearUrl('media', fy)}
    navLabel="メディア出演の年度別一覧"
    kind="media"
  />
</PageLayout>
