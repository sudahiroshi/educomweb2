---
/** 記事詳細（メディア出演、kind: media） */
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import EventDetail from '../../components/EventDetail.astro';

export const getStaticPaths = (async () => {
  const events = await getCollection('events', (e) => e.data.kind === 'media');
  return events.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
---

<EventDetail entry={entry} />
